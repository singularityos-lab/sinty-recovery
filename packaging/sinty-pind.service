[Unit]
Description=Sinty PIN change broker (unprivileged desktop session -> re-seal via sintykey)
After=sinty-recoverd.service

[Service]
Type=simple
ExecStart=/usr/libexec/sinty-pind
Restart=on-failure
RestartSec=10
# root: sintykey change-pin writes the sealed blobs under /var/lib/sinty and drives
# the TPM. It never touches user homes, so ProtectHome stays on.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sinty /run

[Install]
WantedBy=graphical.target
